digraph object_sem10 {
  rankdir=LR;
  bgcolor="white";
  fontname="Helvetica";
  label="MCA major project, semester 10 (snapshot)";
  fontname="Helvetica-Bold";
  fontsize=12;

  node [fontname="Helvetica", fontsize=10, shape=record, style="rounded,filled",
        fillcolor="white", color="black", penwidth=1.5];
  edge [fontname="Helvetica", fontsize=10, color="black", arrowhead="vee"];

  s2 [label="{Student|roll no: IC2k20-07\l section: B\l semester: 10\l}"];
  p2 [label="{Major Project|title: Performance Predictor\l stack: Python and Next.js\l status: Under Review\l}"];
  repo [label="{Linked Repo|verified: yes\l commits: 42\l}"];
  e1 [label="{Evaluation|total: 85.5\l status: Completed\l}"];
  r1 [label="{Rubric|name: MCA Major Viva\l}"];

  s2 -> p2 [label="submits"];
  p2 -> repo [label="links"];
