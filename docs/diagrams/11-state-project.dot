digraph state_project {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  nodesep=0.5;
  ranksep=0.55;

  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
        fillcolor="white", color="black", penwidth=1.5];
  edge [fontname="Helvetica", fontsize=10, color="black", arrowhead="vee"];

  start [label="", shape=circle, style="filled", fillcolor="black", width=0.25, height=0.25];
  draft [label="Draft"];
  submitted [label="Submitted"];
  review [label="Under\lReview\l"];
  approved [label="Approved"];
  rejected [label="Needs\lChanges\l"];
  pending [label="Awaiting\lEvaluation\l"];
  evaluated [label="Evaluated"];
  archived [label="Archived"];
  end [label="", shape=doublecircle, style="filled", fillcolor="white", color="black", width=0.3, height=0.3];

  start -> draft [label="create"];
  draft -> submitted [label="submit"];
  submitted -> review [label="guide opens"];
  review -> approved [label="approve"];
  review -> rejected [label="ask changes"];
  rejected -> draft [label="revise"];
  approved -> pending [label="assign evaluator"];
  pending -> evaluated [label="marks saved"];
  evaluated -> archived [label="term ends"];
  evaluated -> draft [label="failed, rework same term"];
  archived -> end;
}
