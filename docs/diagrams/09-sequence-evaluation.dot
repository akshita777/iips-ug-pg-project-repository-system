digraph sequence_evaluation {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";

  node [shape=plaintext, fontname="Helvetica"];

  trace [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD COLSPAN="5" BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>Evaluation</B></FONT></TD></TR>
      <TR>
        <TD BGCOLOR="white">Step</TD>
        <TD BGCOLOR="white">Evaluator</TD>
        <TD BGCOLOR="white">Browser</TD>
        <TD BGCOLOR="white">Backend API</TD>
        <TD BGCOLOR="white">Database</TD>
      </TR>
      <TR><TD>1</TD><TD ALIGN="LEFT">opens assigned projects</TD><TD></TD><TD></TD><TD></TD></TR>
      <TR><TD>2</TD><TD></TD><TD ALIGN="LEFT">asks for the list</TD><TD></TD><TD></TD></TR>
      <TR><TD>3</TD><TD></TD><TD></TD><TD ALIGN="LEFT">fetches assigned projects</TD><TD></TD></TR>
      <TR><TD>4</TD><TD></TD><TD></TD><TD></TD><TD ALIGN="LEFT">returns the rows</TD></TR>
      <TR><TD>5</TD><TD></TD><TD ALIGN="LEFT">shows the list</TD><TD></TD><TD></TD></TR>
      <TR><TD>6</TD><TD ALIGN="LEFT">enters marks and feedback</TD><TD></TD><TD></TD><TD></TD></TR>
      <TR><TD>7</TD><TD></TD><TD ALIGN="LEFT">submits the evaluation</TD><TD></TD><TD></TD></TR>
      <TR><TD>8</TD><TD></TD><TD></TD><TD ALIGN="LEFT">saves marks</TD><TD></TD></TR>
      <TR><TD>9</TD><TD></TD><TD></TD><TD ALIGN="LEFT">updates project status</TD><TD></TD></TR>
      <TR><TD>10</TD><TD></TD><TD ALIGN="LEFT">shows success</TD><TD></TD><TD></TD></TR>
    </TABLE>
  >];
}