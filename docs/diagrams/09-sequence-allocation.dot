digraph sequence_allocation {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";

  node [shape=plaintext, fontname="Helvetica"];

  trace [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD COLSPAN="5" BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>Guide allocation</B></FONT></TD></TR>
      <TR>
        <TD BGCOLOR="white">Step</TD>
        <TD BGCOLOR="white">Coordinator</TD>
        <TD BGCOLOR="white">Browser</TD>
        <TD BGCOLOR="white">Backend API</TD>
        <TD BGCOLOR="white">Database</TD>
      </TR>
      <TR><TD>1</TD><TD ALIGN="LEFT">opens allocation page</TD><TD></TD><TD></TD><TD></TD></TR>
      <TR><TD>2</TD><TD></TD><TD ALIGN="LEFT">asks for suggestions</TD><TD></TD><TD></TD></TR>
      <TR><TD>3</TD><TD></TD><TD></TD><TD ALIGN="LEFT">loads students and faculty</TD><TD></TD></TR>
      <TR><TD>4</TD><TD></TD><TD></TD><TD></TD><TD ALIGN="LEFT">returns both lists</TD></TR>
      <TR><TD>5</TD><TD></TD><TD></TD><TD ALIGN="LEFT">runs allocation rules</TD><TD></TD></TR>
      <TR><TD>6</TD><TD></TD><TD ALIGN="LEFT">shows suggestions</TD><TD></TD><TD></TD></TR>
      <TR><TD>7</TD><TD ALIGN="LEFT">confirms or adjusts</TD><TD></TD><TD></TD><TD></TD></TR>
      <TR><TD>8</TD><TD></TD><TD ALIGN="LEFT">saves the pairing</TD><TD></TD><TD></TD></TR>
      <TR><TD>9</TD><TD></TD><TD></TD><TD ALIGN="LEFT">stores allocation</TD><TD></TD></TR>
      <TR><TD>10</TD><TD></TD><TD ALIGN="LEFT">shows confirmation</TD><TD></TD><TD></TD></TR>
    </TABLE>
  >];
}