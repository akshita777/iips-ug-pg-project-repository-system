digraph sequence_submission {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";

  node [shape=plaintext, fontname="Helvetica"];

  trace [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD COLSPAN="5" BGCOLOR="white" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>Project submission</B></FONT></TD></TR>
      <TR>
        <TD BGCOLOR="white">Step</TD>
        <TD BGCOLOR="white">Student</TD>
        <TD BGCOLOR="white">Browser</TD>
        <TD BGCOLOR="white">Backend API</TD>
        <TD BGCOLOR="white">Database</TD>
      </TR>
      <TR><TD>1</TD><TD ALIGN="LEFT">clicks Submit</TD><TD></TD><TD></TD><TD></TD></TR>
      <TR><TD>2</TD><TD></TD><TD ALIGN="LEFT">sends POST submit</TD><TD></TD><TD></TD></TR>
      <TR><TD>3</TD><TD></TD><TD></TD><TD ALIGN="LEFT">sets status to Submitted</TD><TD></TD></TR>
      <TR><TD>4</TD><TD></TD><TD></TD><TD></TD><TD ALIGN="LEFT">saves the row</TD></TR>
      <TR><TD>5</TD><TD></TD><TD></TD><TD ALIGN="LEFT">creates guide notice</TD><TD></TD></TR>
      <TR><TD>6</TD><TD></TD><TD></TD><TD ALIGN="LEFT">replies success</TD><TD></TD></TR>
      <TR><TD>7</TD><TD></TD><TD ALIGN="LEFT">shows confirmation</TD><TD></TD><TD></TD></TR>
    </TABLE>
  >];
}