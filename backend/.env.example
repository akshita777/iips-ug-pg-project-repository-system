# Copy to application-local.yml (git ignored) or export these variables.
# Never commit real secrets. Frontend must never see SUPABASE_SERVICE_KEY.

# JDK used by Maven. Match your install, e.g. /usr/lib/jvm/java-21-openjdk
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk
# PATH="$JAVA_HOME/bin:$PATH"

# Database: local development defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pms
DB_USER=postgres
DB_PASSWORD=postgres

# Database: Supabase Postgres (direct connection, port 5432)
# DB_HOST=db.nrpxldikakaeogoqqmhb.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-database-password-here

# Auth
JWT_SECRET=change-me-in-production

# File storage: local or supabase
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Supabase storage (needs a private bucket named below)
# SUPABASE_URL=https://nrpxldikakaeogoqqmhb.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key-here
# STORAGE_BUCKET=project-files
